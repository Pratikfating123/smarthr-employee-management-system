# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata

# Database (PostgreSQL). Set DB_ENGINE=sqlite ONLY for a quick local smoke test.
DB_ENGINE=postgres
DB_NAME=smarthr
DB_USER=smarthr_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Work schedule used for early/late/missing-punch classification (24h HH:MM)
WORK_START=09:30
WORK_END=18:30
GRACE_MINUTES=15
EARLY_ARRIVAL_MINUTES=15
HALF_DAY_MIN_HOURS=4
# Weekday numbers, Monday=0 ... Sunday=6
WORKING_WEEKDAYS=0,1,2,3,4
ENABLE_SELF_CHECKIN=True

# Production only
DJANGO_SECURE_SSL=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Demo data command (development only). Choose your own password.
DEMO_PASSWORD=
